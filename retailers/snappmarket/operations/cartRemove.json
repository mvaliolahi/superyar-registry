{
  "sdl": "1.2",
  "kind": "operation",
  "retailer": "snappmarket",
  "id": "cartRemove",
  "capability": "cartRemove",
  "version": "2026.10.30-1",
  "requiresEngine": 2,
  "auth": "user",
  "evidence": "observed",
  "request": {
    "method": "PUT",
    "host": "api",
    "path": "/cart/v1/{{cart.id}}",
    "body": {
      "actions": {
        "products": {
          "forEachItem": {
            "id": "{{item.retailerProductId | number}}",
            "type": "DECREMENT",
            "vendor_id": "{{item.extras.vendorId | number}}",
            "qty": "{{item.qty | number}}"
          }
        },
        "source": {
          "name": "PWA"
        }
      },
      "platform": "PWA",
      "UDID": "{{auth.deviceId}}"
    }
  },
  "notes": "DECREMENT with qty removes that many units (Observed, c4924). App policy: only units SuperYar added."
}
