{
  "sdl": "1.2",
  "kind": "operation",
  "retailer": "snappmarket",
  "id": "addressSelect",
  "capability": "addressSelect",
  "version": "2026.10.30-1",
  "requiresEngine": 2,
  "auth": "user",
  "evidence": "observed",
  "params": {
    "addressId": {
      "type": "string",
      "required": true,
      "maxLength": 20
    }
  },
  "request": {
    "method": "PUT",
    "host": "api",
    "path": "/cart/v1/{{cart.id}}",
    "body": {
      "actions": {
        "address": {
          "id": "{{param.addressId | number}}"
        },
        "source": {
          "name": "PWA"
        }
      },
      "platform": "PWA",
      "UDID": "{{auth.deviceId}}"
    }
  },
  "notes": "Ties the vendor's cart to a saved address (actions.address only), as the PWA's useCart does when the active address differs from cart.address.id."
}
