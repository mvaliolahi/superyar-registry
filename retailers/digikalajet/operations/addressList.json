{
  "sdl": "1.2",
  "kind": "operation",
  "retailer": "digikalajet",
  "id": "addressList",
  "capability": "addressList",
  "version": "2026.10.30-2",
  "requiresEngine": 2,
  "auth": "user",
  "evidence": "observed",
  "request": {
    "method": "GET",
    "host": "api",
    "path": "/address/"
  },
  "response": {
    "expectStatus": [
      200
    ],
    "items": {
      "path": "$.data.addresses[*]"
    }
  },
  "mapping": {
    "target": "UserAddress",
    "fields": {
      "id": {
        "path": "@.id",
        "transform": [
          "toString"
        ],
        "required": true
      },
      "title": {
        "path": "@.name",
        "transform": [
          "trim"
        ]
      },
      "text": {
        "path": "@.address",
        "transform": [
          "trim"
        ]
      },
      "lat": {
        "path": "@.latitude",
        "transform": [
          "toDouble"
        ]
      },
      "lng": {
        "path": "@.longitude",
        "transform": [
          "toDouble"
        ]
      },
      "isDefault": {
        "path": "@.is_default",
        "transform": [
          "toBool"
        ]
      },
      "inRange": {
        "path": "@.in_service_range",
        "transform": [
          "toBool"
        ]
      }
    }
  },
  "notes": "Read only. Live 2026-10-30: the maintainer's 5 addresses came back with name and coordinates; one saved without a map pin has latitude/longitude 0,0 = position unknown (the app must not measure distance to it). Coordinates are strings. Personal data: kept in memory, never logged; no fixture is committed. Live HAR 2026-10-30 matched: data.addresses[*] with id, name, address, latitude/longitude (strings), is_default, in_service_range."
}
