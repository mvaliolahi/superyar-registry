{
  "sdl": "1.2",
  "kind": "operation",
  "retailer": "digikalajet",
  "id": "addressSelect",
  "capability": "addressSelect",
  "version": "2026.10.30-1",
  "requiresEngine": 2,
  "auth": "user",
  "evidence": "observed",
  "params": {
    "addressId": {
      "type": "string",
      "required": true,
      "maxLength": 20
    }
  },
  "request": {
    "method": "POST",
    "host": "api",
    "path": "/cart/cart-shipment/{{cart.shipmentId}}/change-address/",
    "body": {
      "address_id": "{{param.addressId | number}}"
    }
  },
  "notes": "Ties one shop's cart shipment to a saved address. GET on the same path lists valid/invalid (out-of-range) addresses first; SuperYar never creates, edits or deletes addresses."
}
