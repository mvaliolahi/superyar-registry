{
  "sdl": "1.1",
  "kind": "operation",
  "retailer": "digikalajet",
  "capability": "search",
  "version": "2026.10.30-1",
  "requiresEngine": 1,
  "scope": "context",
  "request": {
    "method": "GET",
    "host": "api",
    "path": "/v2/search/",
    "query": {
      "q": "{{param.query}}",
      "page": "{{page.number}}",
      "latitude": "{{ctx.lat | format:'%.6f'}}",
      "longitude": "{{ctx.lng | format:'%.6f'}}"
    },
    "timeoutMs": 10000
  },
  "params": { "query": { "type": "string", "required": true, "maxLength": 100 } },
  "pagination": { "style": "pageNumber", "startAt": 1, "pageSize": 6, "maxPages": 2, "hasMore": { "jsonPath": "$.data.products.pager.total_pages", "compare": "gtPage" } },
  "response": {
    "expectStatus": [200],
    "items": { "parentPath": "$.data.products.result[*]", "childPath": "@.products[*]", "bind": "parent" },
    "cache": { "ttlSeconds": 900, "scope": "context" }
  },
  "storeIdPath": "parent.id",
  "storeMapping": {
    "name": { "path": "parent.title", "transform": ["normalizePersian"] },
    "isOpen": { "path": "parent.working_status.is_open", "transform": ["toBool"] },
    "etaMinutes": { "path": "parent.delivery.estimate_time", "transform": ["toLong"] },
    "rating": { "path": "parent.rating.rate", "transform": ["toDouble"] },
    "deliveryTerms.feeRial": { "path": "parent.delivery.cost", "transform": ["toLong", "unit:rial"] },
    "deliveryTerms.minOrderRial": { "path": "@.shop.cart_close_limit", "transform": ["toLong", "unit:rial"] },
    "deliveryTerms.freeDeliveryThresholdRial": { "path": "parent.delivery.free_shipping_price", "transform": ["toLong", "unit:rial"] },
    "extras.activityType": { "path": "parent.activity_type", "transform": ["toString"] }
  },
  "mapping": {
    "target": "RetailerOffer",
    "fields": {
      "retailerProductId": { "path": "@.product_id", "transform": ["toString"], "required": true },
      "title": { "path": "@.title", "transform": ["trim", "normalizePersian"], "required": true },
      "barcode": { "path": "@.serial_barcode", "transform": ["toString", "digitsOnly", "gtinOrNull"] },
      "basePriceRial": { "path": "@.price.price", "transform": ["toLong", "unit:rial"], "required": true },
      "discountRial": { "path": "@.price.discount", "transform": ["toLong", "unit:rial"] },
      "availability": { "path": "@.stock.has_stock", "transform": ["toBool"] },
      "badges": [
        { "path": "@.badges.is_kalabarg", "transform": ["toBool", "flag:KALABARG"] },
        { "path": "@.badges.is_amazing", "transform": ["toBool", "flag:SPECIAL_DEAL"] }
      ],
      "imageUrl": { "path": "@.media", "transform": ["absoluteUrl:images"] },
      "categoryIds": { "paths": ["@.category.id"], "transform": ["toString"] },
      "size": { "path": "@.title", "transform": ["extractSize"] },
      "extras.itemId": { "path": "@.id", "transform": ["toString"] },
      "deepLink": { "template": "https://www.digikalajet.com/shop/product/{{parent.id}}/{{@.id}}/" }
    }
  },
  "notes": "Each result[*] element is a shop with products[≤10]; the shop object is the element itself (confirmed 2026-10-30). The pager counts shops (6 per page). listPriceRial (aggregated_price) stays unmapped until Q-JET-5 confirms it is the printed consumer price.",
  "fixtures": [
    {
      "file": "fixtures/search.200.json",
      "bind": { "param": { "query": "شیر" } },
      "expect": {
        "count": 4,
        "stores": 2,
        "first": { "storeId": "163114904961", "retailerProductId": "179119014273", "barcode": "6260272803783", "basePriceRial": 1000000, "discountRial": 20000, "priceRial": 980000, "availability": "IN_STOCK", "badges": ["KALABARG"], "extras.itemId": "55543971", "size": { "value": 946, "unit": "ml", "raw": "946 میلی لیتر" } }
      }
    }
  ]
}
